<UserControl x:Class="AeroDebrief.UI.Controls.Player.WaveformDisplayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AeroDebrief.UI.Controls"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header with zoom controls -->
            <RowDefinition Height="*"/>    <!-- Waveform viewer -->
            <RowDefinition Height="Auto"/> <!-- Minimap -->
        </Grid.RowDefinitions>
        
        <!-- Header with Zoom Controls -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" 
                       Style="{StaticResource SubHeaderTextStyle}" 
                       Text="Waveform Viewer"
                       VerticalAlignment="Center"/>
            
            <!-- GPU/CPU Status Badge -->
            <Border Grid.Column="1"
                    Background="{Binding EngineStatusColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CornerRadius="10"
                    Padding="8,3"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    ToolTip="{Binding EngineStatusTooltip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Visibility="{Binding ShowEngineStatus, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel Orientation="Horizontal">
                    <!-- Icon -->
                    <ContentControl x:Name="EngineIconHost"
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,4,0" />
                    <TextBlock Text="{Binding EngineType, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                               FontFamily="Segoe UI"
                               FontSize="10" 
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <!-- Zoom Control Buttons -->
            <StackPanel Grid.Column="2" 
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="{Binding ShowZoomControls, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="Zoom:" 
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                
                <Button x:Name="ZoomInButton"
                        Content="+" 
                        Click="ZoomIn_Click"
                        Style="{StaticResource ModernSecondaryButton}"
                        FontSize="14"
                        FontWeight="Bold"
                        Padding="10,4"
                        Margin="0,0,4,0"
                        ToolTip="Zoom In (2x)"/>
                
                <Button x:Name="ZoomOutButton"
                        Content="-" 
                        Click="ZoomOut_Click"
                        Style="{StaticResource ModernSecondaryButton}"
                        FontSize="14"
                        FontWeight="Bold"
                        Padding="10,4"
                        Margin="0,0,4,0"
                        ToolTip="Zoom Out (0.5x)"/>
                
                <Button x:Name="ZoomResetButton"
                        Content="?" 
                        Click="ZoomReset_Click"
                        Style="{StaticResource ModernSecondaryButton}"
                        FontFamily="Segoe UI Symbol"
                        FontSize="14"
                        Padding="8,4"
                        ToolTip="Reset Zoom (Show Full Waveform)"/>
            </StackPanel>
        </Grid>

        <!-- Waveform Display -->
        <local:WaveformWithMiniMap x:Name="WaveformDisplay"
                                 Grid.Row="1"
                                 WaveformData="{Binding WaveformData, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 FrequencyWaveforms="{Binding FrequencyWaveforms, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 PlayheadPosition="{Binding PlayheadPosition, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                 BufferStartPosition="{Binding BufferStartPosition, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                 BufferEndPosition="{Binding BufferEndPosition, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                 TotalDuration="{Binding TotalDuration, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 IsLoading="{Binding IsLoading, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 LoadingMessage="{Binding LoadingMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 GenerationProgress="{Binding LoadingProgress, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                 IsInteractive="True"
                                 ShowMiniMap="False"
                                 SeekRequested="WaveformDisplay_SeekRequested"
                                 ZoomRegionSelected="WaveformDisplay_ZoomRegionSelected"
                                 Margin="0"/>
        
        <!-- Minimap (without transport buttons) -->
        <local:WaveformMiniMap x:Name="MiniMapDisplay"
                              Grid.Row="2"
                              WaveformData="{Binding WaveformData, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              FrequencyWaveforms="{Binding FrequencyWaveforms, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              PlayheadPosition="{Binding PlayheadPosition, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                              ZoomStartTime="{Binding ZoomStartTime, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                              ZoomEndTime="{Binding ZoomEndTime, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                              TotalDuration="{Binding TotalDuration, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              MinimapClicked="MiniMap_MinimapClicked"
                              MinimapDragged="MiniMap_MinimapDragged"
                              Height="{Binding MinimapHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Visibility="{Binding ShowMinimap, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}"
                              Margin="0,12,0,0"/>
    </Grid>
</UserControl>
