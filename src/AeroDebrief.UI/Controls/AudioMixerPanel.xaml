<UserControl x:Class="AeroDebrief.UI.Controls.AudioMixerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AeroDebrief.UI.Controls"
             xmlns:vm="clr-namespace:AeroDebrief.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        
        <!-- Style for mixer channel strips -->
        <Style x:Key="MixerChannelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource AccentBrush}"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="AUDIO MIXER" 
                           FontWeight="Bold" 
                           FontSize="12"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                
                <Button Grid.Column="1" 
                        Content="Reset All"
                        Click="ResetAll_Click"
                        Style="{StaticResource SmallButtonStyle}"
                        Foreground="White"
                        BorderBrush="White"/>
            </Grid>
        </Border>
        
        <!-- Mixer Channels -->
        <ScrollViewer Grid.Row="1" 
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled">
            
            <ItemsControl x:Name="MixerChannelsControl"
                         ItemsSource="{Binding MixerChannels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource MixerChannelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Channel name + controls -->
                                    <RowDefinition Height="Auto"/> <!-- Volume fader -->
                                    <RowDefinition Height="Auto"/> <!-- Pan control -->
                                    <RowDefinition Height="Auto"/> <!-- Mute/Solo buttons -->
                                </Grid.RowDefinitions>
                                
                                <!-- Channel Name + Close -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Text="{Binding DisplayName}" 
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    
                                    <Button Grid.Column="1" 
                                            Content="X" 
                                            FontSize="12"
                                            Width="20" 
                                            Height="20"
                                            Padding="0"
                                            Click="RemoveChannel_Click"
                                            Tag="{Binding Frequency}"
                                            ToolTip="Remove from mixer"
                                            Style="{StaticResource SmallButtonStyle}"/>
                                </Grid>
                                
                                <!-- Volume Fader -->
                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0" 
                                               Text="Vol" 
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="0,0,5,0"/>
                                    
                                    <Slider Grid.Column="1" 
                                            Minimum="0" 
                                            Maximum="2" 
                                            Value="{Binding Volume, Mode=TwoWay}"
                                            TickFrequency="0.1"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            ValueChanged="VolumeSlider_ValueChanged"
                                            Tag="{Binding Frequency}"/>
                                    
                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding Volume, StringFormat={}{0:P0}}" 
                                               FontSize="10"
                                               Width="35"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="5,0,0,0"/>
                                </Grid>
                                
                                <!-- Pan Control -->
                                <Grid Grid.Row="2" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0" 
                                               Text="Pan" 
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="0,0,5,0"/>
                                    
                                    <Slider Grid.Column="1" 
                                            Minimum="-1" 
                                            Maximum="1" 
                                            Value="{Binding Pan, Mode=TwoWay}"
                                            TickFrequency="0.1"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            ValueChanged="PanSlider_ValueChanged"
                                            Tag="{Binding Frequency}"/>
                                    
                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding Pan, Converter={StaticResource PanDisplayConverter}}" 
                                               FontSize="10"
                                               Width="35"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="5,0,0,0"/>
                                </Grid>
                                
                                <!-- Mute/Solo Buttons -->
                                <StackPanel Grid.Row="3" 
                                           Orientation="Horizontal" 
                                           HorizontalAlignment="Center">
                                    
                                    <ToggleButton Content="M" 
                                                 Width="30" 
                                                 Height="24"
                                                 IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                 Checked="Mute_Checked"
                                                 Unchecked="Mute_Unchecked"
                                                 Tag="{Binding Frequency}"
                                                 ToolTip="Mute"
                                                 Style="{StaticResource MuteButtonStyle}"
                                                 Margin="2"/>
                                    
                                    <ToggleButton Content="S" 
                                                 Width="30" 
                                                 Height="24"
                                                 IsChecked="{Binding IsSolo, Mode=TwoWay}"
                                                 Checked="Solo_Checked"
                                                 Unchecked="Solo_Unchecked"
                                                 Tag="{Binding Frequency}"
                                                 ToolTip="Solo"
                                                 Style="{StaticResource SoloButtonStyle}"
                                                 Margin="2"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <!-- Empty State -->
        <StackPanel Grid.Row="1" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Visibility="{Binding MixerChannels.Count, Converter={StaticResource ZeroToVisibleConverter}}">
            <TextBlock Text="?" 
                       FontSize="48" 
                       HorizontalAlignment="Center"
                       Opacity="0.3"
                       Margin="0,0,0,10"/>
            <TextBlock Text="No active channels" 
                       FontSize="14" 
                       Opacity="0.5"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
            <TextBlock Text="Select frequencies to add them to the mixer" 
                       FontSize="11" 
                       Opacity="0.4"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
