<UserControl x:Class="AeroDebrief.UI.Controls.Charts.UnifiedGraphControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:charts="clr-namespace:AeroDebrief.UI.Controls.Charts"
             xmlns:vm="clr-namespace:AeroDebrief.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:UnifiedGraphViewModel, IsDesignTimeCreatable=False}"
             Focusable="True">
    
    <Grid>
        <!-- Main Chart -->
        <lvc:CartesianChart Series="{Binding Series}"
                           XAxes="{Binding XAxes}"
                           YAxes="{Binding YAxes}"
                           TooltipPosition="Hidden"
                           Background="Transparent"/>
        
        <!-- Phase 9 Step 1: Loading Spinner Overlay -->
        <charts:LoadingSpinnerOverlay DataContext="{Binding}"
                                     Visibility="{Binding IsLoadingTiles, Converter={StaticResource BoolToVisibilityConverter}}"/>
        
        <!-- Phase 9 Step 2: Error Banner Overlay -->
        <!-- TODO: Add ErrorBannerOverlay once XAML compilation issue is resolved -->
        
        <!-- Phase 9 Step 3: Performance Stats Overlay -->
        <charts:PerformanceStatsOverlay DataContext="{Binding}"
                                       Visibility="{Binding ShowPerformanceStats, Converter={StaticResource BoolToVisibilityConverter}}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Margin="10"/>
    </Grid>
</UserControl>
