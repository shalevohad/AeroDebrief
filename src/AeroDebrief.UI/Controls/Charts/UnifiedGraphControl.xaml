<UserControl x:Class="AeroDebrief.UI.Controls.Charts.UnifiedGraphControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:charts="clr-namespace:AeroDebrief.UI.Controls.Charts"
             xmlns:vm="clr-namespace:AeroDebrief.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:UnifiedGraphViewModel, IsDesignTimeCreatable=False}"
             Focusable="True"
             Background="Transparent">
    
    <Grid>
        <!-- Main Chart -->
        <lvc:CartesianChart x:Name="MainChart"
                           Series="{Binding Series}"
                           XAxes="{Binding XAxes}"
                           YAxes="{Binding YAxes}"
                           TooltipPosition="Hidden"
                           Background="Transparent"
                           MouseWheel="OnChartMouseWheel"
                           MouseDown="OnChartMouseDown"
                           MouseMove="OnChartMouseMove"
                           MouseUp="OnChartMouseUp"/>
        
        <!-- Phase 5.1: Zoom Level Indicator Badge -->
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10"
                Background="#DD000000"
                CornerRadius="4"
                Padding="8,4"
                Visibility="{Binding ZoomLevel, Converter={StaticResource ZoomLevelToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="??" FontSize="14" Margin="0,0,4,0" Foreground="White"/>
                <TextBlock Foreground="White" FontSize="12" FontWeight="SemiBold">
                    <Run Text="Zoom: "/>
                    <Run Text="{Binding ZoomLevel, StringFormat='{}{0:F1}x', Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>
        
        <!-- Phase 9 Step 1: Loading Spinner Overlay -->
        <charts:LoadingSpinnerOverlay DataContext="{Binding}"
                                     Visibility="{Binding IsLoadingTiles, Converter={StaticResource BoolToVisibilityConverter}}"/>
        
        <!-- Phase 9 Step 2: Error Banner Overlay -->
        <!-- TODO: Add ErrorBannerOverlay once XAML compilation issue is resolved -->
        
        <!-- Phase 9 Step 3: Performance Stats Overlay -->
        <charts:PerformanceStatsOverlay DataContext="{Binding}"
                                       Visibility="{Binding ShowPerformanceStats, Converter={StaticResource BoolToVisibilityConverter}}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Margin="10"/>
    </Grid>
</UserControl>
