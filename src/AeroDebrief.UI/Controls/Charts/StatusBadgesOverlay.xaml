<UserControl x:Class="AeroDebrief.UI.Controls.Charts.StatusBadgesOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             d:DesignHeight="40" d:DesignWidth="200"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
        <Border Background="#22000000" CornerRadius="4" Padding="6" Margin="4">
            <TextBlock Text="GPU/CPU" Foreground="White"/>
        </Border>
        <Border Background="#22000000" CornerRadius="4" Padding="6" Margin="4">
            <TextBlock Text="RAM: -- MB" Foreground="White"/>
        </Border>
    </StackPanel>
</UserControl>