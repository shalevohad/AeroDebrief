<UserControl x:Class="AeroDebrief.UI.Controls.Tacview.TacviewStatusControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="48" d:DesignWidth="1200">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <!-- Status indicator colors -->
        <SolidColorBrush x:Key="StatusConnectedBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="StatusSynchronizedBrush" Color="#2196F3"/>
        <SolidColorBrush x:Key="StatusDegradedBrush" Color="#FF9800"/>
        <SolidColorBrush x:Key="StatusDisconnectedBrush" Color="#757575"/>
    </UserControl.Resources>
    
    <Grid ClipToBounds="False">
        <!-- COMPACT SINGLE-LINE STATUS BAR -->
        <Border Style="{StaticResource ModernCard}" 
                Padding="12,10,12,10"
                MinHeight="44"
                ClipToBounds="False">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Icon + Title/Status Stack -->
                    <ColumnDefinition Width="Auto"/> <!-- Connection Status Badge -->
                    <ColumnDefinition Width="Auto"/> <!-- Selected Pilots Badge -->
                    <ColumnDefinition Width="Auto"/> <!-- Sync indicator (if connected) -->
                    <ColumnDefinition Width="*"/>    <!-- Spacer -->
                    <ColumnDefinition Width="Auto"/> <!-- Speed warning (if clamped) -->
                    <ColumnDefinition Width="Auto"/> <!-- Quick actions -->
                </Grid.ColumnDefinitions>
                
                <!-- LEFT: Icon + Title + Status Message (Stacked Vertically) -->
                <StackPanel Grid.Column="0" 
                           Orientation="Horizontal" 
                           VerticalAlignment="Center"
                           Margin="0,0,12,0">
                    <!-- Tacview Icon - Aircraft in layered boxes -->
                    <Grid Width="24" Height="24" 
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"
                          ClipToBounds="False">
                        <Grid.Effect>
                            <DropShadowEffect Color="{Binding StatusColor.(SolidColorBrush.Color)}" 
                                            Opacity="0.6" 
                                            ShadowDepth="0" 
                                            BlurRadius="8"/>
                        </Grid.Effect>
                        
                        <!-- Outer box - Status color background -->
                        <Border Background="{Binding StatusColor}"
                               CornerRadius="4"/>
                        
                        <!-- Inner box - Dark/Black background -->
                        <Border Background="#1A1A1A"
                               CornerRadius="2"
                               Margin="3"/>
                        
                        <!-- Aircraft silhouette (simplified top-down view) -->
                        <Viewbox Width="12" Height="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Canvas Width="16" Height="16">
                                <!-- Aircraft body (fuselage) -->
                                <Rectangle Fill="White" Width="2" Height="10" 
                                          Canvas.Left="7" Canvas.Top="3"/>
                                
                                <!-- Wings (horizontal) -->
                                <Rectangle Fill="White" Width="14" Height="2" 
                                          Canvas.Left="1" Canvas.Top="7"/>
                                
                                <!-- Tail fins (vertical stabilizers) -->
                                <Polygon Fill="White" 
                                        Points="6,3 8,1 10,3"/>
                                
                                <!-- Nose cone -->
                                <Polygon Fill="White" 
                                        Points="7,13 8,15 9,13"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    
                    <!-- Title and Status Message Stacked -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tacview" 
                                  Style="{StaticResource SubHeaderTextStyle}"
                                  FontSize="12"
                                  Margin="0,0,0,2"/>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StatusMessage}" 
                                      Style="{StaticResource BodyTextStyle}"
                                      FontSize="10"
                                      Opacity="0.7"
                                      Margin="0,0,8,0"/>
                            
                            <TextBlock Text="{Binding PortDisplay}" 
                                      Style="{StaticResource MonospaceTextStyle}"
                                      FontSize="9"
                                      Opacity="0.6"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                
                <!-- CONNECTION STATUS BADGE (Red/Green/Gray) -->
                <Border Grid.Column="1"
                       Background="{Binding StatusColor}"
                       CornerRadius="12"
                       Padding="10,4,10,4"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       ToolTip="{Binding StatusMessage}">
                    <TextBlock Text="{Binding ConnectionStatusText}" 
                              Foreground="White"
                              FontSize="10"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"/>
                </Border>
                
                <!-- SELECTED PILOTS COUNT BADGE (only when pilots selected) -->
                <Border Grid.Column="2"
                       Background="{StaticResource AccentBrush}"
                       CornerRadius="12"
                       Padding="10,4,10,4"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasSelectedPilots, Converter={StaticResource BoolToVisibilityConverter}}"
                       ToolTip="Selected pilots (click details button to view)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✈" 
                                  Foreground="White"
                                  FontSize="11"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding SelectedPilots.Count}" 
                                  Foreground="White"
                                  FontSize="11"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- SYNC QUALITY INDICATOR (only when synchronized) -->
                <StackPanel Grid.Column="3" 
                           Orientation="Horizontal" 
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Visibility="{Binding IsSynchronized, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Sync:" 
                              Style="{StaticResource BodyTextStyle}"
                              VerticalAlignment="Center"
                              FontSize="10"
                              Opacity="0.7"
                              Margin="0,0,6,0"/>
                    
                    <ProgressBar Value="{Binding SyncQualityPercent}" 
                                Maximum="100" 
                                Width="60"
                                Height="6"
                                Foreground="{StaticResource AccentBrush}"
                                Background="{StaticResource BorderBrush}"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>
                    
                    <TextBlock Text="{Binding SyncDriftDisplay}" 
                              Style="{StaticResource MonospaceTextStyle}"
                              VerticalAlignment="Center"
                              FontSize="9"/>
                </StackPanel>
                
                <!-- SPEED CLAMPING WARNING BADGE (only when clamped) -->
                <Border Grid.Column="5"
                       Background="{StaticResource WarningBrush}"
                       CornerRadius="4"
                       Padding="8,4,8,4"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsSpeedClamped, Converter={StaticResource BoolToVisibilityConverter}}"
                       ToolTip="{Binding SpeedClampWarning}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" 
                                  Foreground="White"
                                  FontSize="11"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"/>
                        <TextBlock Text="Speed Limited" 
                                  Foreground="White"
                                  FontSize="10"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- RIGHT: Quick Actions -->
                <StackPanel Grid.Column="6" 
                           Orientation="Horizontal" 
                           VerticalAlignment="Center">
                    <!-- Details button - opens popup with full controls -->
                    <Button Content="⋮" 
                           x:Name="DetailsButton"
                           Style="{StaticResource SmallButtonStyle}"
                           ToolTip="Show Tacview details and controls"
                           Width="32" 
                           Height="32"
                           Padding="0"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           Click="OnDetailsButtonClick"/>
                    
                    <Button Content="🔄" 
                           Command="{Binding ReconnectCommand}"
                           Style="{StaticResource SmallButtonStyle}"
                           ToolTip="Reconnect to Tacview"
                           Width="32" 
                           Height="32"
                           Padding="0"
                           FontSize="14"
                           VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- DETAILS POPUP - Full Tacview controls (opens on details button click) -->
        <Popup x:Name="DetailsPopup"
               PlacementTarget="{Binding ElementName=DetailsButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Style="{StaticResource ModernCard}" 
                    Padding="12"
                    Width="350"
                    MaxHeight="500">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- SELECTED PILOTS -->
                        <Expander Style="{StaticResource ModernExpander}"
                                 IsExpanded="True"
                                 Margin="0,0,0,6"
                                 Visibility="{Binding HasSelectedPilots, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Expander.Header>
                                <TextBlock Text="Selected Pilots" 
                                          Style="{StaticResource BodyTextStyle}"
                                          FontWeight="Medium"/>
                            </Expander.Header>
                            
                            <ItemsControl ItemsSource="{Binding SelectedPilots}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource TertiaryBackgroundBrush}"
                                               BorderBrush="{StaticResource BorderBrush}"
                                               BorderThickness="1"
                                               CornerRadius="4"
                                               Padding="8,4"
                                               Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0" 
                                                          Text="{Binding PilotName}"
                                                          Style="{StaticResource BodyTextStyle}"
                                                          FontWeight="Medium"
                                                          VerticalAlignment="Center"/>
                                                
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding PanDisplay}" 
                                                              Style="{StaticResource MonospaceTextStyle}"
                                                              FontSize="10"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding FrequencyDisplay}" 
                                                              Style="{StaticResource BodyTextStyle}"
                                                              FontSize="10"
                                                              Opacity="0.7"
                                                              VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        
                        <!-- SPATIAL AUDIO (PAN) -->
                        <Expander Style="{StaticResource ModernExpander}"
                                 IsExpanded="False"
                                 Margin="0,0,0,6"
                                 Visibility="{Binding HasSelectedPilots, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Expander.Header>
                                <TextBlock Text="Spatial Audio" 
                                          Style="{StaticResource BodyTextStyle}"
                                          FontWeight="Medium"/>
                            </Expander.Header>
                            
                            <StackPanel Margin="0,8,0,0">
                                <!-- Pan mode selector -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0" 
                                              Text="Mode" 
                                              Style="{StaticResource BodyTextStyle}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"/>
                                    
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <RadioButton Content="Auto" 
                                                    GroupName="PanMode"
                                                    IsChecked="{Binding IsAutoPan}"
                                                    Command="{Binding SetAutoPanCommand}"
                                                    Style="{StaticResource ModernRadioButton}"
                                                    Margin="0,0,8,0"/>
                                        <RadioButton Content="Manual" 
                                                    GroupName="PanMode"
                                                    IsChecked="{Binding IsManualPan}"
                                                    Command="{Binding SetManualPanCommand}"
                                                    Style="{StaticResource ModernRadioButton}"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Manual pan controls -->
                                <ItemsControl ItemsSource="{Binding SelectedPilots}"
                                             Visibility="{Binding IsManualPan, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0" 
                                                          Text="{Binding PilotName}" 
                                                          Style="{StaticResource BodyTextStyle}"
                                                          VerticalAlignment="Center"
                                                          TextTrimming="CharacterEllipsis"/>
                                                

                                                <TextBlock Grid.Column="1" 
                                                          Text="{Binding PanDisplay}"
                                                          Style="{StaticResource MonospaceTextStyle}"
                                                          FontSize="10"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Right"
                                                          Margin="0,0,8,0"/>
                                                
                                                <Slider Grid.Column="2" 
                                                       Minimum="-1" Maximum="1" 
                                                       Value="{Binding Pan, Mode=TwoWay}"
                                                       TickFrequency="0.1"
                                                       IsSnapToTickEnabled="True"
                                                       Style="{StaticResource ModernSlider}"
                                                       VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <TextBlock Text="Changes sync to Tacview automatically"
                                          Style="{StaticResource BodyTextStyle}"
                                          FontSize="10"
                                          Opacity="0.6"
                                          FontStyle="Italic"
                                          Margin="0,4,0,0"/>
                            </StackPanel>
                        </Expander>
                        
                        <!-- FREQUENCY FILTERING -->
                        <Expander Style="{StaticResource ModernExpander}"
                                 IsExpanded="False"
                                 Margin="0,0,0,6"
                                 Visibility="{Binding HasSelectedPilots, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Expander.Header>
                                <TextBlock Text="Frequency Filters" 
                                          Style="{StaticResource BodyTextStyle}"
                                          FontWeight="Medium"/>
                            </Expander.Header>
                            
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Per-Pilot" 
                                          Style="{StaticResource BodyTextStyle}"
                                          FontWeight="Medium"
                                          Margin="0,0,0,4"/>
                                
                                <ItemsControl ItemsSource="{Binding SelectedPilots}" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Style="{StaticResource ModernExpander}" Margin="0,0,0,4">
                                                <Expander.Header>
                                                    <TextBlock Text="{Binding PilotName}" 
                                                              Style="{StaticResource BodyTextStyle}"
                                                              FontSize="11"/>
                                                </Expander.Header>
                                                
                                                <StackPanel Margin="0,6,0,0">
                                                    <ItemsControl ItemsSource="{Binding AllFrequencies}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding}"
                                                                         Style="{StaticResource ModernCheckBox}"
                                                                         FontSize="11"
                                                                         Margin="0,0,0,2"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <Button Content="All" 
                                                               Command="{Binding DataContext.EnableAllFrequenciesCommand, 
                                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}"
                                                               Style="{StaticResource SmallButtonStyle}"
                                                               Padding="8,4"
                                                               FontSize="10"
                                                               Margin="0,0,4,0"/>
                                                        <Button Content="None" 
                                                               Command="{Binding DataContext.DisableAllFrequenciesCommand, 
                                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}"
                                                               Style="{StaticResource ModernSecondaryButton}"
                                                               Padding="8,4"
                                                               FontSize="10"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <Separator Background="{StaticResource BorderBrush}" Margin="0,8"/>
                                
                                <TextBlock Text="General (Non-Selected)" 
                                          Style="{StaticResource BodyTextStyle}"
                                          FontWeight="Medium"
                                          Margin="0,0,0,2"/>
                                <TextBlock Text="Default: All disabled" 
                                          Style="{StaticResource BodyTextStyle}"
                                          FontSize="10"
                                          Opacity="0.6"
                                          Margin="0,0,0,4"/>
                                

                                <ItemsControl ItemsSource="{Binding AllKnownFrequencies}" Margin="0,0,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="FrequencyBorder"
                                                   Background="Transparent"
                                                   CornerRadius="4"
                                                   Padding="2,1"
                                                   Margin="0,0,0,2">
                                                <CheckBox Content="{Binding DisplayName}"
                                                         IsChecked="{Binding IsGeneralEnabled, Mode=TwoWay}"
                                                         Style="{StaticResource ModernCheckBox}"
                                                         FontSize="11"/>
                                            </Border>
                                            
                                            <!-- Glow effect for newly discovered frequencies -->
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsNewlyDiscovered}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <!-- Glow animation: fade in and out -->
                                                                <ColorAnimation Storyboard.TargetName="FrequencyBorder"
                                                                               Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                               From="#4CAF50"
                                                                               To="Transparent"
                                                                               Duration="0:0:2"
                                                                               AutoReverse="False"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="Enable All" 
                                           Command="{Binding EnableAllGeneralFrequenciesCommand}"
                                           Style="{StaticResource SmallButtonStyle}"
                                           Padding="8,4"
                                           FontSize="10"
                                           Margin="0,0,4,0"/>
                                    <Button Content="Disable All" 
                                           Command="{Binding DisableAllGeneralFrequenciesCommand}"
                                           Style="{StaticResource ModernSecondaryButton}"
                                           Padding="8,4"
                                           FontSize="10"/>
                                </StackPanel>
                                

                                <TextBlock Text="Changes sync to Tacview automatically"
                                          Style="{StaticResource BodyTextStyle}"
                                          FontSize="10"
                                          Opacity="0.6"
                                          FontStyle="Italic"/>
                            </StackPanel>
                        </Expander>
                        
                        <!-- SETTINGS - Now expanded by default -->
                        <Expander Style="{StaticResource ModernExpander}"
                                 IsExpanded="True">
                            <Expander.Header>
                                <TextBlock Text="Settings" 
                                          Style="{StaticResource BodyTextStyle}"
                                          FontWeight="Medium"/>
                            </Expander.Header>
                            
                            <StackPanel Margin="0,8,0,0">
                                <CheckBox Content="Auto-connect on startup"
                                         IsChecked="{Binding Config.AutoConnect}"
                                         Style="{StaticResource ModernCheckBox}"
                                         Margin="0,0,0,4"/>
                                <CheckBox Content="Auto-reconnect on disconnect"
                                         IsChecked="{Binding Config.AutoReconnect}"
                                         Style="{StaticResource ModernCheckBox}"
                                         Margin="0,0,0,8"/>
                                
                                <TextBlock Text="Connection" 
                                          Style="{StaticResource BodyTextStyle}"
                                          FontWeight="Medium"
                                          Margin="0,0,0,4"/>
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0" 
                                              Text="Host" 
                                              Style="{StaticResource BodyTextStyle}"
                                              VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" 
                                            Text="{Binding Config.Host}"
                                            Style="{StaticResource ModernTextBox}"
                                            FontSize="11"
                                            Padding="6,4"/>
                                    
                                    <TextBlock Grid.Column="2" 
                                              Text="Port" 
                                              Style="{StaticResource BodyTextStyle}"
                                              VerticalAlignment="Center"
                                              Margin="8,0,0,0"/>
                                    <TextBox Grid.Column="3" 
                                            Text="{Binding Config.Port}"
                                            Style="{StaticResource ModernTextBox}"
                                            FontSize="11"
                                            Padding="6,4"/>
                                </Grid>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Test Connection" 
                                           Command="{Binding TestConnectionCommand}"
                                           Style="{StaticResource SmallButtonStyle}"
                                           Padding="8,4"
                                           FontSize="10"
                                           Margin="0,0,4,0"/>
                                    <Button Content="Save" 
                                           Command="{Binding SaveSettingsCommand}"
                                           Style="{StaticResource ModernSecondaryButton}"
                                           Padding="8,4"
                                           FontSize="10"/>
                                </StackPanel>
                                

                                <Border Background="#E3F2FD"
                                       BorderBrush="{StaticResource AccentBrush}"
                                       BorderThickness="1"
                                       CornerRadius="4"
                                       Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="Bidirectional Sync" 
                                                  Style="{StaticResource BodyTextStyle}"
                                                  FontWeight="SemiBold"
                                                  FontSize="11"
                                                  Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock TextWrapping="Wrap" 
                                                  Style="{StaticResource BodyTextStyle}"
                                                  FontSize="10"
                                                  Margin="0,4,0,0"
                                                  LineHeight="14">
                                            Configuration changes are automatically synced between AeroDebrief and Tacview:
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource BodyTextStyle}"
                                                  FontSize="10"
                                                  Margin="8,4,0,0"
                                                  Opacity="0.8"
                                                  LineHeight="14">
                                            * Pan mode and values
                                            <LineBreak/>
                                            * Per-pilot frequency filters
                                            <LineBreak/>
                                            * General frequency filters
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
