<UserControl x:Class="AeroDebrief.UI.Controls.ServerSourcePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:AeroDebrief.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type=vm:ServerSourceViewModel}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource AccentBrush}"
                Padding="10,8">
            <TextBlock Text="SRS SERVER" 
                       FontWeight="Bold" 
                       FontSize="12"
                       Foreground="White"/>
        </Border>
        
        <!-- Connection Info -->
        <ScrollViewer Grid.Row="1" 
                     VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                
                <!-- Connection Status -->
                <GroupBox Header="Connection" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{Binding ConnectionStatus}" 
                                   TextWrapping="Wrap"
                                   Margin="0,5"/>
                        
                        <TextBlock Text="{Binding ServerVersion, StringFormat='Version: {0}'}" 
                                   Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}}"
                                   FontSize="11"
                                   Opacity="0.7"/>
                    </StackPanel>
                </GroupBox>
                
                <!-- Recording Controls -->
                <GroupBox Header="Recording" 
                         Margin="0,0,0,10"
                         Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel>
                        <Button Content="Start Recording" 
                                Command="{Binding RecordCommand}"
                                Visibility="{Binding IsRecording, Converter={StaticResource InverseBoolToVisConverter}}"
                                Style="{StaticResource ModernButtonStyle}"
                                Margin="0,5"/>
                        
                        <Button Content="Stop Recording" 
                                Command="{Binding StopRecordingCommand}"
                                Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisConverter}}"
                                Style="{StaticResource ModernButtonStyle}"
                                Margin="0,5"/>
                    </StackPanel>
                </GroupBox>
                
                <!-- Server Bookmarks -->
                <GroupBox Header="Bookmarks" Margin="0,0,0,10">
                    <StackPanel>
                        <ListBox ItemsSource="{Binding Bookmarks}"
                                SelectedItem="{Binding SelectedBookmark, Mode=TwoWay}"
                                Height="150"
                                Margin="0,5">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" 
                                                  FontWeight="SemiBold"
                                                  Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Ip}" 
                                                  Opacity="0.7"
                                                  Margin="0,0,5,0"/>
                                        <TextBlock Text=":" Opacity="0.7"/>
                                        <TextBlock Text="{Binding Port}" 
                                                  Opacity="0.7"
                                                  Margin="5,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        
                        <StackPanel Orientation="Horizontal" 
                                   HorizontalAlignment="Center"
                                   Margin="0,5">
                            <Button Content="+" 
                                   Command="{Binding AddBookmarkCommand}"
                                   ToolTip="Add current server"
                                   Width="30"
                                   Margin="2"/>
                            <Button Content="?" 
                                   Command="{Binding DeleteBookmarkCommand}"
                                   CommandParameter="{Binding SelectedBookmark}"
                                   ToolTip="Delete selected"
                                   Width="30"
                                   Margin="2"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Disconnect Button -->
        <Button Grid.Row="2" 
                Content="Disconnect"
                Command="{Binding DisconnectCommand}"
                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}}"
                Style="{StaticResource ModernButtonStyle}"
                Margin="10"/>
    </Grid>
</UserControl>
