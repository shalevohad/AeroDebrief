<UserControl x:Class="AeroDebrief.UI.Controls.FileSourcePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:AeroDebrief.UI.ViewModels"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300"
             Background="{StaticResource PrimaryBackgroundBrush}"
             d:DataContext="{d:DesignInstance Type=vm:FileSourceViewModel}">

	<Grid Margin="0">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Main Content Area -->
		<ScrollViewer Grid.Row="0" 
                     VerticalScrollBarVisibility="Auto"
                     Padding="16">
			<StackPanel>

				<!-- Current File Info Card (updated layout) -->
				<Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<!-- File Icon spans both rows and is centered vertically -->
						<fa:FontAwesome Grid.Row="1" Grid.Column="0"
                                      Icon="FileAudioOutline"
                                      FontSize="24"
                                      Foreground="{StaticResource AccentBrush}"
                                      Margin="6,2,6,0"
                                      VerticalAlignment="Top"/>

						<!-- Header -->
						<TextBlock Grid.Row="0" Grid.Column="1"
                                   Style="{StaticResource SubHeaderTextStyle}" 
                                   Text="Current File"
                                   Margin="0,0,0,6"/>

						<!-- File info and loading area -->
						<StackPanel Grid.Row="1" Grid.Column="1">

							<!-- Loading area: text above progress bar, vertically centered with icon -->
							<StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
								<TextBlock Text="Loading..."
                                           Style="{StaticResource BodyTextStyle}"
                                           FontSize="11"
                                           Margin="0,0,0,6"/>
								<ProgressBar IsIndeterminate="True"
                                            Width="160"
                                            Height="6"
                                            Foreground="{StaticResource AccentBrush}"/>
							</StackPanel>
						</StackPanel>
					</Grid>
				</Border>

				<!-- Drop Zone Card -->
				<Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
					<StackPanel>
						<TextBlock Style="{StaticResource SubHeaderTextStyle}" 
                                   Text="Open File"
                                   Margin="0,0,0,8"/>

						<Border x:Name="DropZone"
                                Background="{StaticResource TertiaryBackgroundBrush}" 
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                Height="120"
                                AllowDrop="True"
                                PreviewDragOver="OnPreviewDragOver"
                                Drop="OnDrop"
                                DragLeave="OnDragLeave">
							<StackPanel HorizontalAlignment="Center" 
                                       VerticalAlignment="Center">
								<fa:FontAwesome Icon="CloudUpload" 
                                              FontSize="32" 
                                              Foreground="{StaticResource AccentBrush}"
                                              HorizontalAlignment="Center"
                                              Margin="0,0,0,8"/>
								<TextBlock Text="Drop .adb or .raw files here" 
                                           Style="{StaticResource BodyTextStyle}"
                                           HorizontalAlignment="Center"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
								<TextBlock Text="Or use the button below" 
                                           Style="{StaticResource BodyTextStyle}"
                                           HorizontalAlignment="Center" 
                                           FontSize="11"
                                           Margin="0,4,0,0"/>
							</StackPanel>
						</Border>

						<Button Command="{Binding BrowseCommand}"
                                Style="{StaticResource ModernButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,12,0,0">
							<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
								<fa:FontAwesome Icon="FolderOpen" 
                                              FontSize="14" 
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"/>
								<TextBlock Text="Browse for File..." VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
					</StackPanel>
				</Border>

				<!-- Recent Files Card (unchanged) -->
				<Border Style="{StaticResource ModernCard}" Margin="0,0,0,0">
					<StackPanel>
						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>

							<TextBlock Grid.Column="0"
                                       Style="{StaticResource SubHeaderTextStyle}" 
                                       Text="Recent Files"
                                       Margin="0"/>

							<!-- Clear Recent Files Button -->
							<Button Grid.Column="1"
                                    Command="{Binding ClearRecentFilesCommand}"
                                    Style="{StaticResource ModernSecondaryButton}"
                                    Padding="6,3"
                                    ToolTip="Clear recent files list">
								<StackPanel Orientation="Horizontal">
									<fa:FontAwesome Icon="Trash" 
                                                  FontSize="10" 
                                                  Margin="0,0,4,0"
                                                  VerticalAlignment="Center"/>
									<TextBlock Text="Clear" 
                                               FontSize="10"
                                               VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
						</Grid>

						<!-- Recent Files List -->
						<ListBox ItemsSource="{Binding RecentFiles}" 
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MaxHeight="250"
                                 MouseDoubleClick="RecentFiles_MouseDoubleClick">
							<ListBox.ItemContainerStyle>
								<Style TargetType="ListBoxItem">
									<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
									<Setter Property="Padding" Value="0"/>
									<Setter Property="Margin" Value="0,0,0,8"/>
									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="ListBoxItem">
												<Border x:Name="ItemBorder"
                                                        Background="{StaticResource SecondaryBackgroundBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="12,8"
                                                        Cursor="Hand">
													<ContentPresenter/>
												</Border>
												<ControlTemplate.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter TargetName="ItemBorder" Property="Background" Value="#E3F2FD"/>
														<Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
													</Trigger>
													<Trigger Property="IsSelected" Value="True">
														<Setter TargetName="ItemBorder" Property="Background" Value="#BBDEFB"/>
														<Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
													</Trigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
								</Style>
							</ListBox.ItemContainerStyle>
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>

										<!-- File Icon -->
										<fa:FontAwesome Grid.Column="0"
                                                      Icon="FileOutline"
                                                      FontSize="16"
                                                      Foreground="{StaticResource TextSecondaryBrush}"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center"/>

										<!-- File Path with Filename Emphasized -->
										<StackPanel Grid.Column="1" VerticalAlignment="Center">
											<TextBlock Text="{Binding Converter={StaticResource FileNameConverter}}" 
                                                       Style="{StaticResource BodyTextStyle}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"/>
											<TextBlock Text="{Binding Converter={StaticResource FilePathConverter}}" 
                                                       Style="{StaticResource BodyTextStyle}"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"/>
										</StackPanel>

										<!-- Open Button -->
										<Button Grid.Column="2" 
                                                Command="{Binding DataContext.OpenRecentFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ModernSecondaryButton}"
                                                Padding="8,4"
                                                Margin="8,0,0,0">
											<StackPanel Orientation="Horizontal">
												<fa:FontAwesome Icon="Play" 
                                                              FontSize="12" 
                                                              Margin="0,0,4,0"
                                                              VerticalAlignment="Center"/>
												<TextBlock Text="Open" 
                                                           FontSize="11"
                                                           VerticalAlignment="Center"/>
											</StackPanel>
										</Button>
									</Grid>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>

						<!-- Empty State -->
						<StackPanel HorizontalAlignment="Center" 
                                    Margin="0,24"
                                    Visibility="{Binding HasRecentFiles, Converter={StaticResource InverseBoolToVisibilityConverter}}">
							<fa:FontAwesome Icon="FolderOpen" 
                                          FontSize="32" 
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          HorizontalAlignment="Center"
                                          Opacity="0.5"
                                          Margin="0,0,0,8"/>
							<TextBlock Text="No recent files" 
                                       Style="{StaticResource BodyTextStyle}"
                                       HorizontalAlignment="Center"
                                       FontSize="12"/>
							<TextBlock Text="Open a file to get started" 
                                       Style="{StaticResource BodyTextStyle}"
                                       HorizontalAlignment="Center"
                                       FontSize="10"
                                       Margin="0,4,0,0"/>
						</StackPanel>
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
