<UserControl x:Class="AeroDebrief.UI.Controls.UnifiedPlayerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AeroDebrief.UI.Controls"
             xmlns:player="clr-namespace:AeroDebrief.UI.Controls.Player"
             xmlns:tacview="clr-namespace:AeroDebrief.UI.Controls.Tacview"
             xmlns:charts="clr-namespace:AeroDebrief.UI.Controls.Charts"
             xmlns:vm="clr-namespace:AeroDebrief.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{StaticResource PrimaryBackgroundBrush}"
             d:DataContext="{d:DesignInstance Type=vm:UnifiedPlayerViewModel, IsDesignTimeCreatable=True}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="101.9"/>
            <!-- Player Header -->
            <RowDefinition Height="Auto"/>
            <!-- Tacview Status - no MinHeight so it collapses completely -->
            <RowDefinition/>
            <!-- Main content with UnifiedGraph -->
        </Grid.RowDefinitions>

        <!-- PLAYER HEADER - Top header with file/source controls -->
        <player:PlayerHeaderControl Grid.Row="0"
                               StatusMessage="{Binding StatusMessage}"
                               SourceName="{Binding CurrentSourceName}"
                               CurrentMode="{Binding CurrentMode}"
                               IsIdle="{Binding IsIdle}"
                               ChangeSourceCommand="{Binding ChangeSourceCommand}"
                               OpenSettingsCommand="{Binding OpenSettingsCommand}"
                               SourceTypeSelected="OnSourceTypeSelected"
                               FilePanelRequested="OnFilePanelRequested"
                               ServerPanelRequested="OnServerPanelRequested" Margin="0,0,0,64" Grid.RowSpan="2"/>

        <!-- TACVIEW STATUS - Single-line status bar below player header -->
        <!-- Hidden when no source is loaded, visible (but grayed out) when disconnected -->
        <tacview:TacviewStatusControl Grid.Row="1"
                                  x:Name="TacviewStatus"
                                  DataContext="{Binding TacviewIntegration}"
                                  Margin="0,0,0,10">
            <tacview:TacviewStatusControl.Style>
                <Style TargetType="tacview:TacviewStatusControl">
                    <Setter Property="IsEnabled" Value="True"/>
                    <Setter Property="Opacity" Value="1.0"/>
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <!-- Hide completely when TacviewIntegration is null (no source loaded) -->
                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <!-- Gray out when disconnected (but source is loaded) -->
                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                            <Setter Property="Opacity" Value="0.7"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </tacview:TacviewStatusControl.Style>
        </tacview:TacviewStatusControl>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Transport controls -->
                <ColumnDefinition Width="*" MinWidth="400"/>
                <!-- Waveform -->
                <ColumnDefinition Width="8"/>
                <!-- Splitter -->
                <ColumnDefinition Width="350" MinWidth="250" MaxWidth="500"/>
                <!-- Mixer -->
            </Grid.ColumnDefinitions>

            <!-- TRANSPORT CONTROLS -->
            <player:TransportControlsPanel Grid.Column="0"
                                      IsPlaying="{Binding IsPlaying}"
                                      IsPaused="{Binding IsPaused}"
                                      CanPlay="{Binding CanExecutePlay}"
                                      CanPause="{Binding CanExecutePause}"
                                      CanStop="{Binding CanExecuteStop}"
                                      Orientation="Vertical"
                                      ShowSkipButtons="False"
                                      EnableKeyboardShortcuts="True"
                                      PlayRequested="OnPlayRequested"
                                      PauseRequested="OnPauseRequested"
                                      StopRequested="OnStopRequested"
                                      Margin="0,0,8,0"/>

            <!-- WAVEFORM DISPLAY - UnifiedGraphControl (Phase 12: Migrated from legacy) -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header with zoom controls -->
                    <RowDefinition Height="*"/>    <!-- UnifiedGraphControl -->
                </Grid.RowDefinitions>
                
                <!-- Header with Zoom Controls -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" 
                               Style="{StaticResource SubHeaderTextStyle}" 
                               Text="Amplitude Graph"
                               VerticalAlignment="Center"/>
                    
                    <!-- LiveCharts2 Badge -->
                    <Border Grid.Column="1"
                            Background="{StaticResource SuccessBrush}"
                            CornerRadius="10"
                            Padding="8,3"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            ToolTip="LiveCharts2-based rendering&#x0a;Hardware-accelerated, high-performance visualization">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔊" 
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                            <TextBlock Text="SYNC" 
                                       FontSize="10" 
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Zoom Control Buttons -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <TextBlock Text="Zoom:" 
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        
                        <Button x:Name="ZoomInButton"
                                Content="+" 
                                Click="ZoomIn_Click"
                                Style="{StaticResource ModernSecondaryButton}"
                                FontSize="14"
                                FontWeight="Bold"
                                Padding="10,4"
                                Margin="0,0,4,0"
                                ToolTip="Zoom In (2x)"/>
                        
                        <Button x:Name="ZoomOutButton"
                                Content="-" 
                                Click="ZoomOut_Click"
                                Style="{StaticResource ModernSecondaryButton}"
                                FontSize="14"
                                FontWeight="Bold"
                                Padding="10,4"
                                Margin="0,0,4,0"
                                ToolTip="Zoom Out (0.5x)"/>
                        
                        <Button x:Name="ZoomResetButton"
                                Content="⟲" 
                                Click="ZoomReset_Click"
                                Style="{StaticResource ModernSecondaryButton}"
                                FontFamily="Segoe UI Symbol"
                                FontSize="14"
                                Padding="8,4"
                                ToolTip="Reset Zoom (Show Full Range)"/>
                    </StackPanel>
                </Grid>

                <!-- Phase 12: UnifiedGraphControl replaces legacy WaveformDisplayPanel -->
                <charts:UnifiedGraphControl x:Name="UnifiedGraph"
                                           Grid.Row="1"
                                           DataContext="{Binding GraphViewModel}"
                                           MinHeight="200"
                                           Margin="0"/>
            </Grid>

            <!-- GRID SPLITTER -->
            <GridSplitter Grid.Column="2" 
                     Width="2"
                     HorizontalAlignment="Center" 
                     VerticalAlignment="Stretch"
                     Background="{StaticResource BorderBrush}"/>

            <!-- FREQUENCY MIXER -->
            <player:FrequencyMixerPanel Grid.Column="3"
                                   Frequencies="{Binding Frequencies}"
                                   SelectAllCommand="{Binding SelectAllFrequenciesCommand}"
                                   SelectNoneCommand="{Binding SelectNoFrequenciesCommand}"
                                   FrequencySelectionChanged="OnFrequencySelectionChanged"
                                   MixerValueChanged="OnMixerValueChanged"
                                   MixerBooleanChanged="OnMixerBooleanChanged"/>
        </Grid>

        <!-- FILE SOURCE PANEL OVERLAY -->
        <player:FileSourcePanelOverlay Grid.Row="0" Grid.RowSpan="3"
                                  x:Name="FileOverlay"
                                  IsOpen="{Binding IsFileSourcePanelOpen, Mode=TwoWay}"
                                  PanelWidth="400"
                                  PanelTitle="Select Recording File"
                                  EnableKeyboardShortcuts="True"
                                  CloseOnClickOutside="True"
                                  PanelClosed="OnFileSourcePanelClosed"/>

        <!-- SERVER SOURCE PANEL OVERLAY -->
        <player:FileSourcePanelOverlay Grid.Row="0" Grid.RowSpan="3"
                                  x:Name="ServerOverlay"
                                  IsOpen="{Binding IsServerSourcePanelOpen, Mode=TwoWay}"
                                  PanelWidth="400"
                                  PanelTitle="Connect to SRS Server"
                                  EnableKeyboardShortcuts="True"
                                  CloseOnClickOutside="True"
                                  PanelClosed="OnServerSourcePanelClosed"/>
    </Grid>
</UserControl>
