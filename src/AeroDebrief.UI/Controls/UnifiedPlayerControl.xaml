<UserControl x:Class="AeroDebrief.UI.Controls.UnifiedPlayerControl"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
         xmlns:local="clr-namespace:AeroDebrief.UI.Controls"
         xmlns:player="clr-namespace:AeroDebrief.UI.Controls.Player"
         xmlns:tacview="clr-namespace:AeroDebrief.UI.Controls.Tacview"
         xmlns:vm="clr-namespace:AeroDebrief.UI.ViewModels"
         mc:Ignorable="d" 
         d:DesignHeight="800" d:DesignWidth="1200"
         Background="{StaticResource PrimaryBackgroundBrush}"
         d:DataContext="{d:DesignInstance Type=vm:UnifiedPlayerViewModel, IsDesignTimeCreatable=True}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="101.9"/>
            <!-- Player Header -->
            <RowDefinition Height="Auto" MinHeight="64"/>
            <!-- Tacview Status -->
            <RowDefinition/>
            <!-- Main content -->
        </Grid.RowDefinitions>

        <!-- PLAYER HEADER - Top header with file/source controls -->
        <player:PlayerHeaderControl Grid.Row="0"
                               StatusMessage="{Binding StatusMessage}"
                               SourceName="{Binding CurrentSourceName}"
                               CurrentMode="{Binding CurrentMode}"
                               IsIdle="{Binding IsIdle}"
                               ChangeSourceCommand="{Binding ChangeSourceCommand}"
                               OpenSettingsCommand="{Binding OpenSettingsCommand}"
                               SourceTypeSelected="OnSourceTypeSelected"
                               FilePanelRequested="OnFilePanelRequested" Margin="0,0,0,64" Grid.RowSpan="2"/>

        <!-- TACVIEW STATUS - Single-line status bar below player header -->
        <!-- Always visible, but grayed out and disabled when not available/connected -->
        <tacview:TacviewStatusControl Grid.Row="1"
                                  x:Name="TacviewStatus"
                                  DataContext="{Binding TacviewIntegration}"
                                  Margin="0,0,0,10">
            <tacview:TacviewStatusControl.Style>
                <Style TargetType="tacview:TacviewStatusControl">
                    <Setter Property="IsEnabled" Value="True"/>
                    <Setter Property="Opacity" Value="1.0"/>
                    <Style.Triggers>
                        <!-- Gray out when TacviewIntegration is null (file not loaded) -->
                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Setter Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                        <!-- Gray out when disconnected -->
                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                            <Setter Property="Opacity" Value="0.7"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </tacview:TacviewStatusControl.Style>
        </tacview:TacviewStatusControl>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Transport controls -->
                <ColumnDefinition Width="*" MinWidth="400"/>
                <!-- Waveform -->
                <ColumnDefinition Width="8"/>
                <!-- Splitter -->
                <ColumnDefinition Width="350" MinWidth="250" MaxWidth="500"/>
                <!-- Mixer -->
            </Grid.ColumnDefinitions>

            <!-- TRANSPORT CONTROLS -->
            <player:TransportControlsPanel Grid.Column="0"
                                      IsPlaying="{Binding IsPlaying}"
                                      IsPaused="{Binding IsPaused}"
                                      CanPlay="{Binding CanExecutePlay}"
                                      CanPause="{Binding CanExecutePause}"
                                      CanStop="{Binding CanExecuteStop}"
                                      Orientation="Vertical"
                                      ShowSkipButtons="False"
                                      EnableKeyboardShortcuts="True"
                                      PlayRequested="OnPlayRequested"
                                      PauseRequested="OnPauseRequested"
                                      StopRequested="OnStopRequested"
                                      Margin="0,0,8,0"/>

            <!-- WAVEFORM DISPLAY -->
            <player:WaveformDisplayPanel Grid.Column="1"
                                    x:Name="WaveformPanel"
                                    WaveformData="{Binding WaveformData}"
                                    FrequencyWaveforms="{Binding FrequencyWaveforms}"
                                    PlayheadPosition="{Binding PlayheadPositionNormalized}"
                                    ZoomStartTime="{Binding ZoomStartTime, Mode=TwoWay}"
                                    ZoomEndTime="{Binding ZoomEndTime, Mode=TwoWay}"
                                    TotalDuration="{Binding TotalDuration}"
                                    IsLoading="{Binding IsLoadingWaveform}"
                                    LoadingProgress="{Binding WaveformGenerationProgress}"
                                    EngineType="{Binding WaveformEngineText}"
                                    IsUsingGpu="{Binding IsUsingGpu}"
                                    BufferStartPosition="{Binding BufferStartPosition}"
                                    BufferEndPosition="{Binding BufferEndPosition}"
                                    ShowEngineStatus="True"
                                    ShowZoomControls="True"
                                    ShowMinimap="True"
                                    MinimapHeight="80"
                                    SeekRequested="OnSeekRequested"
                                    ZoomChanged="OnZoomChanged"
                                    WaveformSizeChanged="OnWaveformSizeChanged"/>

            <!-- GRID SPLITTER -->
            <GridSplitter Grid.Column="2" 
                     Width="2"
                     HorizontalAlignment="Center" 
                     VerticalAlignment="Stretch"
                     Background="{StaticResource BorderBrush}"/>

            <!-- FREQUENCY MIXER -->
            <player:FrequencyMixerPanel Grid.Column="3"
                                   Frequencies="{Binding Frequencies}"
                                   SelectAllCommand="{Binding SelectAllFrequenciesCommand}"
                                   SelectNoneCommand="{Binding SelectNoFrequenciesCommand}"
                                   FrequencySelectionChanged="OnFrequencySelectionChanged"
                                   MixerValueChanged="OnMixerValueChanged"
                                   MixerBooleanChanged="OnMixerBooleanChanged"/>
        </Grid>

        <!-- FILE SOURCE PANEL OVERLAY -->
        <player:FileSourcePanelOverlay Grid.Row="0" Grid.RowSpan="3"
                                  x:Name="FileOverlay"
                                  IsOpen="{Binding IsFileSourcePanelOpen, Mode=TwoWay}"
                                  PanelWidth="400"
                                  PanelTitle="Select Recording File"
                                  EnableKeyboardShortcuts="True"
                                  CloseOnClickOutside="True"
                                  PanelClosed="OnFileSourcePanelClosed"/>
    </Grid>
</UserControl>
