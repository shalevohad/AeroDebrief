<UserControl x:Class="AeroDebrief.UI.Controls.UnifiedPlayerControl"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
         xmlns:local="clr-namespace:AeroDebrief.UI.Controls"
         xmlns:player="clr-namespace:AeroDebrief.UI.Controls.Player"
         xmlns:tacview="clr-namespace:AeroDebrief.UI.Controls.Tacview"
         xmlns:charts="clr-namespace:AeroDebrief.UI.Controls.Charts"
         xmlns:vm="clr-namespace:AeroDebrief.UI.ViewModels"
         mc:Ignorable="d" 
         d:DesignHeight="800" d:DesignWidth="1200"
         Background="{StaticResource PrimaryBackgroundBrush}"
         d:DataContext="{d:DesignInstance Type=vm:UnifiedPlayerViewModel, IsDesignTimeCreatable=True}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="101.9"/>
            <!-- Player Header -->
            <RowDefinition Height="Auto"/>
            <!-- Tacview Status - no MinHeight so it collapses completely -->
            <RowDefinition/>
            <!-- Main content -->
            <RowDefinition Height="Auto"/>
            <!-- Unified Graph (collapsible) -->
        </Grid.RowDefinitions>

        <!-- PLAYER HEADER - Top header with file/source controls -->
        <player:PlayerHeaderControl Grid.Row="0"
                               StatusMessage="{Binding StatusMessage}"
                               SourceName="{Binding CurrentSourceName}"
                               CurrentMode="{Binding CurrentMode}"
                               IsIdle="{Binding IsIdle}"
                               ChangeSourceCommand="{Binding ChangeSourceCommand}"
                               OpenSettingsCommand="{Binding OpenSettingsCommand}"
                               SourceTypeSelected="OnSourceTypeSelected"
                               FilePanelRequested="OnFilePanelRequested"
                               ServerPanelRequested="OnServerPanelRequested" Margin="0,0,0,64" Grid.RowSpan="2"/>

        <!-- TACVIEW STATUS - Single-line status bar below player header -->
        <!-- Hidden when no source is loaded, visible (but grayed out) when disconnected -->
        <tacview:TacviewStatusControl Grid.Row="1"
                                  x:Name="TacviewStatus"
                                  DataContext="{Binding TacviewIntegration}"
                                  Margin="0,0,0,10">
            <tacview:TacviewStatusControl.Style>
                <Style TargetType="tacview:TacviewStatusControl">
                    <Setter Property="IsEnabled" Value="True"/>
                    <Setter Property="Opacity" Value="1.0"/>
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <!-- Hide completely when TacviewIntegration is null (no source loaded) -->
                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <!-- Gray out when disconnected (but source is loaded) -->
                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                            <Setter Property="Opacity" Value="0.7"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </tacview:TacviewStatusControl.Style>
        </tacview:TacviewStatusControl>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Transport controls -->
                <ColumnDefinition Width="*" MinWidth="400"/>
                <!-- Waveform -->
                <ColumnDefinition Width="8"/>
                <!-- Splitter -->
                <ColumnDefinition Width="350" MinWidth="250" MaxWidth="500"/>
                <!-- Mixer -->
            </Grid.ColumnDefinitions>

            <!-- TRANSPORT CONTROLS -->
            <player:TransportControlsPanel Grid.Column="0"
                                      IsPlaying="{Binding IsPlaying}"
                                      IsPaused="{Binding IsPaused}"
                                      CanPlay="{Binding CanExecutePlay}"
                                      CanPause="{Binding CanExecutePause}"
                                      CanStop="{Binding CanExecuteStop}"
                                      Orientation="Vertical"
                                      ShowSkipButtons="False"
                                      EnableKeyboardShortcuts="True"
                                      PlayRequested="OnPlayRequested"
                                      PauseRequested="OnPauseRequested"
                                      StopRequested="OnStopRequested"
                                      Margin="0,0,8,0"/>

            <!-- WAVEFORM DISPLAY (legacy) -->
            <player:WaveformDisplayPanel Grid.Column="1"
                                    x:Name="WaveformPanel"
                                    WaveformData="{Binding WaveformData}"
                                    FrequencyWaveforms="{Binding FrequencyWaveforms}"
                                    PlayheadPosition="{Binding PlayheadPositionNormalized}"
                                    ZoomStartTime="{Binding ZoomStartTime, Mode=TwoWay}"
                                    ZoomEndTime="{Binding ZoomEndTime, Mode=TwoWay}"
                                    TotalDuration="{Binding TotalDuration}"
                                    IsLoading="{Binding IsLoadingWaveform}"
                                    LoadingProgress="{Binding WaveformGenerationProgress}"
                                    EngineType="{Binding WaveformEngineText}"
                                    IsUsingGpu="{Binding IsUsingGpu}"
                                    BufferStartPosition="{Binding BufferStartPosition}"
                                    BufferEndPosition="{Binding BufferEndPosition}"
                                    ShowEngineStatus="True"
                                    ShowZoomControls="True"
                                    ShowMinimap="True"
                                    MinimapHeight="80"
                                    SeekRequested="OnSeekRequested"
                                    ZoomChanged="OnZoomChanged"
                                    WaveformSizeChanged="OnWaveformSizeChanged"/>

            <!-- GRID SPLITTER -->
            <GridSplitter Grid.Column="2" 
                     Width="2"
                     HorizontalAlignment="Center" 
                     VerticalAlignment="Stretch"
                     Background="{StaticResource BorderBrush}"/>

            <!-- FREQUENCY MIXER -->
            <player:FrequencyMixerPanel Grid.Column="3"
                                   Frequencies="{Binding Frequencies}"
                                   SelectAllCommand="{Binding SelectAllFrequenciesCommand}"
                                   SelectNoneCommand="{Binding SelectNoFrequenciesCommand}"
                                   FrequencySelectionChanged="OnFrequencySelectionChanged"
                                   MixerValueChanged="OnMixerValueChanged"
                                   MixerBooleanChanged="OnMixerBooleanChanged"/>
        </Grid>

        <!-- LIVECHARTS UNIFIED GRAPH (Phase 1) -->
        <Border Grid.Row="3" 
                x:Name="UnifiedGraphContainer"
                Style="{StaticResource ModernCard}"
                Margin="0,16,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="250"/>
                </Grid.RowDefinitions>
                
                <!-- Header with toggle -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Unified Amplitude Graph" 
                                  FontSize="14" 
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  VerticalAlignment="Center"/>
                        <Border Background="{StaticResource AccentBrush}"
                               CornerRadius="4"
                               Padding="6,2"
                               Margin="8,0,0,0">
                            <TextBlock Text="BETA" 
                                      FontSize="10" 
                                      FontWeight="Bold"
                                      Foreground="White"/>
                        </Border>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- Phase 7 Step 4: Audio sync indicator -->
                        <Border Background="{StaticResource SuccessBrush}"
                               CornerRadius="4"
                               Padding="6,2"
                               Margin="0,0,8,0"
                               ToolTip="Audio synchronization enabled&#x0a;Chart visibility controls audio mute/solo">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔊" 
                                          FontSize="10"
                                          VerticalAlignment="Center"
                                          Margin="0,0,4,0"/>
                                <TextBlock Text="SYNC" 
                                          FontSize="10" 
                                          FontWeight="Bold"
                                          Foreground="White"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <TextBlock Text="LiveCharts2" 
                                  FontSize="11" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                        <ToggleButton x:Name="GraphToggle"
                                     IsChecked="True"
                                     Style="{StaticResource ModernToggleSwitch}"
                                     ToolTip="Show/Hide unified graph"/>
                    </StackPanel>
                </Grid>
                
                <!-- Chart Content -->
                <charts:UnifiedGraphControl x:Name="UnifiedGraph" 
                                           Grid.Row="1"
                                           DataContext="{Binding GraphViewModel}"
                                           Visibility="{Binding IsChecked, ElementName=GraphToggle, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- FILE SOURCE PANEL OVERLAY -->
        <player:FileSourcePanelOverlay Grid.Row="0" Grid.RowSpan="4"
                                  x:Name="FileOverlay"
                                  IsOpen="{Binding IsFileSourcePanelOpen, Mode=TwoWay}"
                                  PanelWidth="400"
                                  PanelTitle="Select Recording File"
                                  EnableKeyboardShortcuts="True"
                                  CloseOnClickOutside="True"
                                  PanelClosed="OnFileSourcePanelClosed"/>

        <!-- SERVER SOURCE PANEL OVERLAY -->
        <player:FileSourcePanelOverlay Grid.Row="0" Grid.RowSpan="4"
                                  x:Name="ServerOverlay"
                                  IsOpen="{Binding IsServerSourcePanelOpen, Mode=TwoWay}"
                                  PanelWidth="400"
                                  PanelTitle="Connect to SRS Server"
                                  EnableKeyboardShortcuts="True"
                                  CloseOnClickOutside="True"
                                  PanelClosed="OnServerSourcePanelClosed"/>
    </Grid>
</UserControl>
