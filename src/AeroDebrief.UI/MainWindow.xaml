<Window x:Class="AeroDebrief.UI.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="clr-namespace:AeroDebrief.UI"
xmlns:controls="clr-namespace:AeroDebrief.UI.Controls"
Title="AeroDebrief Player" 
Height="900" 
Width="1400"
MinHeight="600"
MinWidth="1000"
Background="{StaticResource PrimaryBackgroundBrush}"
WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource PrimaryBackgroundBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Recording..." Click="OpenRecording_Click" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About"/>
            </MenuItem>
        </Menu>
        
        <!-- Status Bar (Phase 2.5) -->
        <StatusBar DockPanel.Dock="Bottom" 
                   Background="{StaticResource PrimaryBackgroundBrush}" 
                   Height="24"
                   DataContext="{Binding DataContext, ElementName=UnifiedPlayer}">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            
            <!-- Status Message -->
            <StatusBarItem Grid.Column="0">
                <TextBlock Text="{Binding StatusMessage, FallbackValue='Ready'}" 
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </StatusBarItem>
            
            <!-- File Format -->
            <StatusBarItem Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Format: " 
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Visibility="{Binding FileFormat, Converter={StaticResource StringToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding FileFormat}" 
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="SemiBold"
                               Visibility="{Binding FileFormat, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>
            </StatusBarItem>
            
            <!-- File Name -->
            <StatusBarItem Grid.Column="2" Margin="10,0,0,0">
                <TextBlock Text="{Binding CurrentSourceName}" 
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontWeight="Medium"/>
            </StatusBarItem>
        </StatusBar>
        
        <!-- Unified Player Control -->
        <controls:UnifiedPlayerControl x:Name="UnifiedPlayer"/>

    </DockPanel>
</Window>