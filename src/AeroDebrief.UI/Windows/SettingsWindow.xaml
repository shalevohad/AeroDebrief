<Window x:Class="AeroDebrief.UI.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings" 
        Height="600" 
        Width="800"
        MinHeight="500"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PrimaryBackgroundBrush}"
        ResizeMode="CanResize">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" 
                Style="{StaticResource ModernCard}" 
                Margin="16,16,16,8">
            <StackPanel>
                <TextBlock Style="{StaticResource HeaderTextStyle}" 
                           Text="Settings"/>
                <TextBlock Style="{StaticResource BodyTextStyle}" 
                           Text="Configure AeroDebrief Player preferences"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Settings Content -->
        <Grid Grid.Row="1" Margin="16,8,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Categories List -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}">
                <ListBox x:Name="CategoryList"
                         SelectedIndex="0"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="CategoryList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Border"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="12,10"
                                                Margin="4">
                                            <TextBlock Text="{Binding}" 
                                                      FontSize="13"
                                                      FontWeight="SemiBold"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                <Setter TargetName="Border" Property="CornerRadius" Value="6"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SecondaryBackgroundBrush}"/>
                                                <Setter TargetName="Border" Property="CornerRadius" Value="6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Content="General"/>
                    <ListBoxItem Content="Audio"/>
                    <ListBoxItem Content="Appearance"/>
                    <ListBoxItem Content="Advanced"/>
                </ListBox>
            </Border>
            
            <!-- Settings Panels -->
            <Border Grid.Column="2" Style="{StaticResource ModernCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        
                        <!-- General Settings -->
                        <StackPanel x:Name="GeneralPanel" Visibility="Visible">
                            <TextBlock Style="{StaticResource SubHeaderTextStyle}" 
                                       Text="General Settings"/>
                            
                            <!-- Master Volume -->
                            <TextBlock Text="Default Master Volume" 
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,12,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="MasterVolumeSlider"
                                        Minimum="0"
                                        Maximum="200"
                                        Value="{Binding MasterVolume, Mode=TwoWay}"
                                        TickFrequency="10"
                                        IsSnapToTickEnabled="True"
                                        Style="{StaticResource ModernSlider}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ElementName=MasterVolumeSlider, Path=Value, StringFormat={}{0:F0}%}"
                                           Style="{StaticResource MonospaceTextStyle}"
                                           Width="50"
                                           TextAlignment="Right"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            
                            <!-- Enable Frequency Filter by Default -->
                            <CheckBox Content="Enable frequency filter by default"
                                      IsChecked="{Binding EnableFrequencyFilterByDefault, Mode=TwoWay}"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,16,0,0"/>
                            
                            <!-- Enable Debug Logging -->
                            <CheckBox Content="Enable debug logging"
                                      IsChecked="{Binding EnableDebugLogging, Mode=TwoWay}"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,8,0,0"/>
                            
                            <TextBlock Text="Detailed logging for troubleshooting issues"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Margin="28,2,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        
                        <!-- Audio Settings -->
                        <StackPanel x:Name="AudioPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SubHeaderTextStyle}" 
                                       Text="Audio Settings"/>
                            
                            <!-- Audio Activity Threshold -->
                            <TextBlock Text="Audio Activity Threshold" 
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,12,0,4"/>
                            <TextBlock Text="Minimum audio level to consider as active (0-32767)"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,4"
                                       TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="ActivityThresholdSlider"
                                        Minimum="0"
                                        Maximum="5000"
                                        Value="{Binding AudioActivityThreshold, Mode=TwoWay}"
                                        TickFrequency="100"
                                        IsSnapToTickEnabled="True"
                                        Style="{StaticResource ModernSlider}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ElementName=ActivityThresholdSlider, Path=Value, StringFormat={}{0:F0}}"
                                           Style="{StaticResource MonospaceTextStyle}"
                                           Width="60"
                                           TextAlignment="Right"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            
                            <!-- Minimum Activity Duration -->
                            <TextBlock Text="Minimum Activity Duration (ms)" 
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,16,0,4"/>
                            <TextBlock Text="Minimum duration to consider as valid audio activity"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,4"
                                       TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="MinDurationSlider"
                                        Minimum="50"
                                        Maximum="1000"
                                        Value="{Binding AudioActivityMinDuration, Mode=TwoWay}"
                                        TickFrequency="50"
                                        IsSnapToTickEnabled="True"
                                        Style="{StaticResource ModernSlider}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ElementName=MinDurationSlider, Path=Value, StringFormat={}{0:F0}ms}"
                                           Style="{StaticResource MonospaceTextStyle}"
                                           Width="70"
                                           TextAlignment="Right"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                        
                        <!-- Appearance Settings -->
                        <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SubHeaderTextStyle}" 
                                       Text="Appearance Settings"/>
                            
                            <!-- Theme Selection -->
                            <TextBlock Text="Theme" 
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,12,0,4"/>
                            <ComboBox x:Name="ThemeComboBox"
                                      SelectedValue="{Binding ThemeFile, Mode=TwoWay}"
                                      Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem Content="Light" Tag="light.json"/>
                                <ComboBoxItem Content="Dark" Tag="dark.json"/>
                                <ComboBoxItem Content="Custom" Tag="custom.json"/>
                            </ComboBox>
                            
                            <TextBlock Text="Restart required for theme changes to take effect"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        
                        <!-- Advanced Settings -->
                        <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SubHeaderTextStyle}" 
                                       Text="Advanced Settings"/>
                            
                            <!-- Configuration File Location -->
                            <TextBlock Text="Configuration File" 
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,12,0,4"/>
                            <TextBox x:Name="ConfigPathTextBox"
                                     IsReadOnly="True"
                                     Text="{Binding ConfigFilePath, Mode=OneWay}"
                                     Style="{StaticResource ModernTextBox}"/>
                            
                            <Button Content="Open Config Folder"
                                    Click="OpenConfigFolder_Click"
                                    Style="{StaticResource ModernSecondaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0"/>
                            
                            <!-- Reset to Defaults -->
                            <TextBlock Text="Reset Settings" 
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,24,0,4"/>
                            <Button Content="Reset All Settings to Default"
                                    Click="ResetSettings_Click"
                                    Style="{StaticResource ModernSecondaryButton}"
                                    HorizontalAlignment="Left"/>
                            
                            <TextBlock Text="This will reset all settings to their default values"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        
        <!-- Footer Buttons -->
        <Border Grid.Row="2" 
                Style="{StaticResource ModernCard}" 
                Margin="16,8,16,16">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right">
                <Button Content="Apply"
                        Click="Apply_Click"
                        Style="{StaticResource ModernSecondaryButton}"
                        Width="100"
                        Margin="0,0,8,0"/>
                <Button Content="OK"
                        Click="OK_Click"
                        Style="{StaticResource ModernButton}"
                        Width="100"
                        Margin="0,0,8,0"/>
                <Button Content="Cancel"
                        Click="Cancel_Click"
                        Style="{StaticResource ModernSecondaryButton}"
                        Width="100"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
