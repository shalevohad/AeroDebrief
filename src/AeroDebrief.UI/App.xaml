<Application x:Class="AeroDebrief.UI.App"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:helpers="clr-namespace:AeroDebrief.UI.Helpers"
xmlns:converters="clr-namespace:AeroDebrief.UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Emoji Font Family for Icon Support -->
            <!-- <FontFamily x:Key="EmojiFont">Segoe UI Emoji, Segoe UI Symbol, Segoe UI</FontFamily> -->
            
            <!-- Value Converters -->
            <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <helpers:FileNameConverter x:Key="FileNameConverter"/>
            <helpers:FilePathConverter x:Key="FilePathConverter"/>
            <converters:ModeColorConverter x:Key="ModeColorConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>