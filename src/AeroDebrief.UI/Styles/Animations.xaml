<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ========================================
         PHASE 9 STEP 4: Shared Animation Resources
         
         Purpose: Centralized animation definitions for consistent
                  timing and easing across all UI components
         
         Standards:
         - Fast: 200ms (quick feedback)
         - Normal: 300ms (standard transitions)
         - Slow: 500ms (emphasis)
         - Target: 60 FPS (GPU-accelerated)
         ======================================== -->
    
    <!-- ==================== DURATIONS ==================== -->
    
    <Duration x:Key="FastDuration">0:0:0.2</Duration>
    <Duration x:Key="NormalDuration">0:0:0.3</Duration>
    <Duration x:Key="SlowDuration">0:0:0.5</Duration>
    
    <!-- ==================== EASING FUNCTIONS ==================== -->
    
    <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
    <CubicEase x:Key="EaseIn" EasingMode="EaseIn"/>
    <CubicEase x:Key="EaseInOut" EasingMode="EaseInOut"/>
    <QuadraticEase x:Key="QuadEaseOut" EasingMode="EaseOut"/>
    <QuadraticEase x:Key="QuadEaseIn" EasingMode="EaseIn"/>
    
    <!-- ==================== OPACITY ANIMATIONS ==================== -->
    
    <!-- Fade In: 0 ? 1 (300ms, EaseOut) -->
    <Storyboard x:Key="FadeInAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                        From="0" To="1" 
                        Duration="{StaticResource NormalDuration}"
                        EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>
    
    <!-- Fade Out: 1 ? 0 (200ms, EaseIn) -->
    <Storyboard x:Key="FadeOutAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                        From="1" To="0" 
                        Duration="{StaticResource FastDuration}"
                        EasingFunction="{StaticResource EaseIn}"/>
    </Storyboard>
    
    <!-- Fast Fade In: 0 ? 1 (200ms) -->
    <Storyboard x:Key="FastFadeInAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                        From="0" To="1" 
                        Duration="{StaticResource FastDuration}"
                        EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>
    
    <!-- ==================== SLIDE ANIMATIONS ==================== -->
    
    <!-- Slide In From Top: -80 ? 0 (300ms, EaseOut) -->
    <Storyboard x:Key="SlideInFromTopAnimation">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                        From="-80" To="0" 
                        Duration="{StaticResource NormalDuration}"
                        EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>
    
    <!-- Slide Out To Top: 0 ? -80 (200ms, EaseIn) -->
    <Storyboard x:Key="SlideOutToTopAnimation">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                        From="0" To="-80" 
                        Duration="{StaticResource FastDuration}"
                        EasingFunction="{StaticResource EaseIn}"/>
    </Storyboard>
    
    <!-- Slide Up: 50 ? 0 (300ms, EaseOut) -->
    <Storyboard x:Key="SlideUpAnimation">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                        From="50" To="0" 
                        Duration="{StaticResource NormalDuration}"
                        EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>
    
    <!-- ==================== SCALE ANIMATIONS ==================== -->
    
    <!-- Pulse: Scale 1 ? 1.1 (600ms loop) -->
    <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                        From="1" To="1.1" 
                        Duration="0:0:0.6"
                        AutoReverse="True"
                        EasingFunction="{StaticResource EaseInOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                        From="1" To="1.1" 
                        Duration="0:0:0.6"
                        AutoReverse="True"
                        EasingFunction="{StaticResource EaseInOut}"/>
    </Storyboard>
    
    <!-- Subtle Pulse: Scale 1 ? 1.05 (800ms loop) -->
    <Storyboard x:Key="SubtlePulseAnimation" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                        From="1" To="1.05" 
                        Duration="0:0:0.8"
                        AutoReverse="True"
                        EasingFunction="{StaticResource EaseInOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                        From="1" To="1.05" 
                        Duration="0:0:0.8"
                        AutoReverse="True"
                        EasingFunction="{StaticResource EaseInOut}"/>
    </Storyboard>
    
    <!-- Button Hover: Scale 1 ? 1.05 (150ms) -->
    <Storyboard x:Key="ButtonHoverScaleIn">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                        To="1.05" Duration="0:0:0.15"
                        EasingFunction="{StaticResource QuadEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                        To="1.05" Duration="0:0:0.15"
                        EasingFunction="{StaticResource QuadEaseOut}"/>
    </Storyboard>
    
    <!-- Button Hover Out: Scale 1.05 ? 1 (150ms) -->
    <Storyboard x:Key="ButtonHoverScaleOut">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                        To="1" Duration="0:0:0.15"
                        EasingFunction="{StaticResource QuadEaseIn}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                        To="1" Duration="0:0:0.15"
                        EasingFunction="{StaticResource QuadEaseIn}"/>
    </Storyboard>
    
    <!-- Pop In: Scale 0.8 ? 1 (300ms) -->
    <Storyboard x:Key="PopInAnimation">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                        From="0.8" To="1" 
                        Duration="{StaticResource NormalDuration}"
                        EasingFunction="{StaticResource EaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                        From="0.8" To="1" 
                        Duration="{StaticResource NormalDuration}"
                        EasingFunction="{StaticResource EaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                        From="0" To="1" 
                        Duration="{StaticResource NormalDuration}"/>
    </Storyboard>
    
    <!-- ==================== ROTATION ANIMATIONS ==================== -->
    
    <!-- Spin: Continuous 360 degree rotation (1s loop) -->
    <Storyboard x:Key="SpinAnimation" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                        From="0" To="360" 
                        Duration="0:0:1"
                        EasingFunction="{StaticResource EaseInOut}"/>
    </Storyboard>
    
    <!-- Fast Spin: Continuous 360 degree rotation (600ms loop) -->
    <Storyboard x:Key="FastSpinAnimation" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                        From="0" To="360" 
                        Duration="0:0:0.6"/>
    </Storyboard>
    
    <!-- ==================== COMBINED ANIMATIONS ==================== -->
    
    <!-- Fade + Slide In: Combined effect for overlays -->
    <Storyboard x:Key="FadeSlideInAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                        From="0" To="1" 
                        Duration="{StaticResource NormalDuration}"
                        EasingFunction="{StaticResource EaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                        From="20" To="0" 
                        Duration="{StaticResource NormalDuration}"
                        EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>
    
    <!-- Fade + Slide Out: Combined effect for dismissing -->
    <Storyboard x:Key="FadeSlideOutAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                        From="1" To="0" 
                        Duration="{StaticResource FastDuration}"
                        EasingFunction="{StaticResource EaseIn}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                        From="0" To="-20" 
                        Duration="{StaticResource FastDuration}"
                        EasingFunction="{StaticResource EaseIn}"/>
    </Storyboard>
    
    <!-- Fade + Scale In: Combined effect for modals -->
    <Storyboard x:Key="FadeScaleInAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                        From="0" To="1" 
                        Duration="{StaticResource NormalDuration}"
                        EasingFunction="{StaticResource EaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                        From="0.9" To="1" 
                        Duration="{StaticResource NormalDuration}"
                        EasingFunction="{StaticResource EaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                        From="0.9" To="1" 
                        Duration="{StaticResource NormalDuration}"
                        EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>
    
    <!-- ==================== VALUE CHANGE ANIMATIONS ==================== -->
    
    <!-- Flash: Quick opacity pulse to highlight value change -->
    <Storyboard x:Key="ValueChangeFlashAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                        From="0.3" To="1" 
                        Duration="0:0:0.4"
                        EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>
    
    <!-- Color Flash: Brief color change (for background) -->
    <Storyboard x:Key="ColorFlashAnimation">
        <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                       To="#404040" 
                       Duration="0:0:0.1"
                       AutoReverse="True"/>
    </Storyboard>
    
</ResourceDictionary>
