<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>AeroDebrief.UI</RootNamespace>
    <AssemblyName>AeroDebrief.UI</AssemblyName>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <StartupObject>AeroDebrief.UI.Program</StartupObject>
    <Version>1.0.0</Version>
    <Authors>Shalev Ohad</Authors>
    <Company>AeroDebrief</Company>
    <Product>AeroDebrief</Product>
    <Description>WPF UI for AeroDebrief - DCS SRS Playback and Analysis</Description>
    <NoWarn>CS1998;CS8618;CS8600;CS8602;CS8603;CS8604;CS0414;CS0169;NU1701</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NuGetAuditMode>all</NuGetAuditMode>
    
    <!-- Ensure native dependencies (like duckdb.dll) are copied to output -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    
    <!-- DuckDB native library configuration -->
    <DuckDBVersion>v1.1.3</DuckDBVersion>
    <DuckDBDownloadUrl>https://github.com/duckdb/duckdb/releases/download/$(DuckDBVersion)/libduckdb-windows-amd64.zip</DuckDBDownloadUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AeroDebrief.Core\AeroDebrief.Core.csproj" />
    <ProjectReference Include="..\AeroDebrief.Integrations\AeroDebrief.Integrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FontAwesome.WPF" Version="4.7.0.9" />
    <PackageReference Include="LiveChartsCore" Version="2.0.0-rc3.3" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc3.3" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="TestWindows\" />
  </ItemGroup>

  <!-- Automatically download and copy DuckDB native library after build -->
  <Target Name="CopyDuckDBNativeLibrary" AfterTargets="Build">
    <PropertyGroup>
      <DuckDBTempDir>$(TEMP)\duckdb-native-$(DuckDBVersion)</DuckDBTempDir>
      <DuckDBZipFile>$(DuckDBTempDir)\libduckdb.zip</DuckDBZipFile>
      <DuckDBExtractDir>$(DuckDBTempDir)\extracted</DuckDBExtractDir>
      <DuckDBDllPath>$(OutputPath)\duckdb.dll</DuckDBDllPath>
    </PropertyGroup>

    <!-- Check if duckdb.dll already exists in output -->
    <Message Text="Checking for DuckDB native library..." Importance="high" />
    
    <!-- Download and extract if not present -->
    <Message Text="DuckDB native library not found. Downloading..." Importance="high" Condition="!Exists('$(DuckDBDllPath)')" />
    
    <MakeDir Directories="$(DuckDBTempDir)" Condition="!Exists('$(DuckDBDllPath)') AND !Exists('$(DuckDBTempDir)')" />
    
    <DownloadFile SourceUrl="$(DuckDBDownloadUrl)" 
                  DestinationFolder="$(DuckDBTempDir)" 
                  DestinationFileName="libduckdb.zip"
                  Condition="!Exists('$(DuckDBDllPath)') AND !Exists('$(DuckDBZipFile)')" />
    
    <Unzip SourceFiles="$(DuckDBZipFile)" 
           DestinationFolder="$(DuckDBExtractDir)" 
           OverwriteReadOnlyFiles="true"
           Condition="!Exists('$(DuckDBDllPath)') AND Exists('$(DuckDBZipFile)')" />
    
    <ItemGroup>
      <DuckDBNativeDll Include="$(DuckDBExtractDir)\**\duckdb.dll" />
    </ItemGroup>
    
    <Copy SourceFiles="@(DuckDBNativeDll)" 
          DestinationFolder="$(OutputPath)" 
          SkipUnchangedFiles="true"
          Condition="!Exists('$(DuckDBDllPath)') AND '@(DuckDBNativeDll)' != ''" />
    
    <Message Text="✅ DuckDB native library ready at: $(DuckDBDllPath)" Importance="high" Condition="Exists('$(DuckDBDllPath)')" />
    <Warning Text="⚠️ Could not find or download duckdb.dll. Please run: scripts\copy-duckdb-native.ps1" Condition="!Exists('$(DuckDBDllPath)')" />
  </Target>

</Project>
