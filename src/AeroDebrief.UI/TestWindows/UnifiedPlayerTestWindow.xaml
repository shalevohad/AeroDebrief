<Window x:Class="AeroDebrief.UI.TestWindows.UnifiedPlayerTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AeroDebrief.UI"
        xmlns:controls="clr-namespace:AeroDebrief.UI.Controls"
        Title="AeroDebrief Player - DEBUG MODE" 
        Height="1000" 
        Width="1400"
        MinHeight="700"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBackgroundBrush}">
    
    <Window.Resources>
        <!-- Reference the ModernStyles -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <!-- Debug Header -->
            <RowDefinition Height="Auto"/>
            <!-- MAIN WINDOW CONTENT (EXACT SAME AS PRODUCTION) -->
            <RowDefinition Height="*"/>
            <!-- Debug Footer / Test Results -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- DEBUG HEADER (Only in TestWindow) -->
        <Border Grid.Row="0" 
                Background="#FF6B35"
                BorderBrush="#E65525"
                BorderThickness="0,0,0,2"
                Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="?? DEBUG MODE" 
                               FontSize="16" 
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    
                    <TextBlock Text="  |  " 
                               Foreground="#80FFFFFF"
                               VerticalAlignment="Center"
                               Margin="10,0"/>
                    
                    <TextBlock x:Name="TestStatusText"
                               Text="Integration Testing Environment - Production UI Below"
                               FontSize="12"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Run All Tests" 
                            Click="RunAllTests_Click"
                            Background="White"
                            Foreground="#FF6B35"
                            Padding="15,8"
                            Margin="5,0"/>
                    
                    <Button Content="Reset" 
                            Click="Reset_Click"
                            Background="White"
                            Foreground="#FF6B35"
                            Padding="15,8"
                            Margin="5,0"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- PRODUCTION MAINWINDOW CONTENT (EXACT SAME AS RELEASE) -->
        <!-- This is IDENTICAL to MainWindow.xaml content -->
        <DockPanel Grid.Row="1">
            <!-- Menu Bar (same as MainWindow) -->
            <Menu DockPanel.Dock="Top" Background="{StaticResource PrimaryBackgroundBrush}">
                <MenuItem Header="_File">
                    <MenuItem Header="E_xit" Click="Exit_Click"/>
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="_About"/>
                </MenuItem>
            </Menu>
            
            <!-- Unified Player Control (EXACT SAME as MainWindow) -->
            <controls:UnifiedPlayerControl x:Name="UnifiedPlayer"/>
        </DockPanel>
        
        <!-- DEBUG FOOTER / TEST RESULTS (Only in TestWindow) -->
        <Expander Grid.Row="2"
                  Header="?? Test Results &amp; Debug Logs (DEBUG MODE ONLY)"
                  IsExpanded="False"
                  Background="#2C3E50"
                  Foreground="White"
                  BorderBrush="#E65525"
                  BorderThickness="0,2,0,0">
            <Grid Height="200" Background="#34495E">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Test Results -->
                <Border Grid.Column="0" 
                        Background="#2C3E50"
                        BorderBrush="#1A252F"
                        BorderThickness="0,0,1,0"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="Test Results" 
                                   FontWeight="Bold" 
                                   FontSize="12"
                                   Foreground="White"
                                   Margin="0,0,0,5"/>
                        
                        <ScrollViewer Grid.Row="1" 
                                     VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TestResultsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#1A252F"
                                               BorderThickness="0,0,0,1"
                                               Padding="5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" 
                                                          FontSize="14"
                                                          Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Message}" 
                                                          Foreground="White"
                                                          TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
                
                <GridSplitter Grid.Column="1" 
                             Width="4" 
                             HorizontalAlignment="Center"
                             Background="#1A252F"/>
                
                <!-- Debug Log -->
                <Border Grid.Column="2" 
                        Background="#2C3E50"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Debug Log" 
                                      FontWeight="Bold" 
                                      FontSize="12"
                                      Foreground="White"
                                      Margin="0,0,10,5"/>
                            <Button Content="Clear" 
                                   Click="ClearLog_Click"
                                   Background="White"
                                   Foreground="#2C3E50"
                                   Padding="8,2"/>
                        </StackPanel>
                        
                        <ScrollViewer Grid.Row="1" 
                                     VerticalScrollBarVisibility="Auto"
                                     x:Name="LogScrollViewer">
                            <TextBox x:Name="DebugLogTextBox"
                                    IsReadOnly="True"
                                    TextWrapping="Wrap"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Foreground="#ECF0F1"
                                    FontFamily="Consolas"
                                    FontSize="10"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Expander>
    </Grid>
</Window>
